{
  "name": "merak-paddock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack && node scripts/check-build.mjs",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "payload": "payload",
    "import:preview": "node --import tsx scripts/preview-flighty.ts",
    "build:qa": "NEXT_DIST_DIR=.next-qa next build --webpack",
    "start:qa": "NEXT_DIST_DIR=.next-qa DATABASE_URL=file:./.data/browser-qa/test.db MEDIA_DIR=./.data/browser-qa/media SERVER_URL=http://127.0.0.1:3002 next start --hostname 127.0.0.1 --port 3002",
    "package:linux": "bash scripts/package-linux.sh"
  },
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "overrides": {
    "undici": "7.29.1",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@js-temporal/polyfill": "0.5.1",
    "@payloadcms/db-sqlite": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "d3-geo": "3.1.1",
    "graphql": "16.14.2",
    "next": "16.3.6",
    "papaparse": "5.7.0",
    "payload": "3.90.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "3.1.1",
    "@types/node": "22.20.4",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/topojson-client": "3.1.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
