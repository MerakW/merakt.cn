FLIGHT_CLOUD_URL=https://merakt.cn
BARK_SERVER_URL=https://api.day.app/

# fr24 for the current experiment; flightaware for AeroAPI after configuring its key.
FLIGHT_DATA_PROVIDER=fr24
# Optional key file mounted under /run/secrets (see compose.yaml).
# FLIGHTAWARE_API_KEY_FILE=/run/secrets/flightaware-key

# Optional existing outbound proxy for FR24 only; leave empty for direct access.
FR24_PROXY=

# Optional: manually confirmed VariFlight queries; independent of the automatic FR24 provider.
# VARIFLIGHT_API_KEY_FILE=/run/secrets/variflight-key
VARIFLIGHT_DAILY_QUERY_LIMIT=4
VARIFLIGHT_MONTHLY_QUERY_LIMIT=20
VARIFLIGHT_CACHE_DB=/var/lib/flight-logger/variflight.sqlite
