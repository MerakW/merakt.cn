# Generate a unique secret before running: openssl rand -hex 32
PAYLOAD_SECRET=
DATABASE_URL=file:./.data/merak.db
SERVER_URL=http://127.0.0.1:3000
MEDIA_DIR=./.data/media
NEXT_TELEMETRY_DISABLED=1

# Single-photo COS publishing (server only; never use NEXT_PUBLIC_ credentials).
COS_BUCKET=
COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=
# Optional temporary-credential token.
COS_SESSION_TOKEN=

# Flight Logger test integration. Server-only credentials; leave disabled until configured.
FLIGHT_SYNC_ENABLED=0
# remote: home worker fetches and pushes; local: website runs the provider.
FLIGHT_SYNC_MODE=local
# Cloud remote mode only: public key file inside the container, never the private key.
FLIGHT_WORKER_PUBLIC_KEY_FILE=/data/flight-worker-public.pem
# Auto-publish newly logged completed flights. Existing records keep their visibility.
FLIGHT_SYNC_VISIBILITY=public
# Generate separately from PAYLOAD_SECRET: openssl rand -hex 32
FLIGHT_SYNC_TOKEN=
BARK_KEY=
BARK_SERVER_URL=https://api.day.app/
FR24_TRANSPORT=curl_cffi
# Python environment with scripts/flight-sync-requirements.txt installed.
FR24_PYTHON=python3
FR24_IMPERSONATE=chrome120

# Select the home-side data provider; no automatic paid fallback.
FLIGHT_DATA_PROVIDER=fr24
FLIGHTAWARE_API_KEY_FILE=

# Optional existing outbound proxy for FR24 only; leave empty for direct access.
FR24_PROXY=
