# Generate a unique secret before running: openssl rand -hex 32
PAYLOAD_SECRET=
DATABASE_URL=file:./.data/merak.db
SERVER_URL=http://127.0.0.1:3000
MEDIA_DIR=./.data/media
NEXT_TELEMETRY_DISABLED=1

# Single-photo COS publishing (server only; never use NEXT_PUBLIC_ credentials).
COS_BUCKET=
COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=
# Optional temporary-credential token.
COS_SESSION_TOKEN=

# Flight Logger test integration. Server-only credentials; leave disabled until configured.
FLIGHT_SYNC_ENABLED=0
# remote: home worker fetches and pushes; local: website runs the provider.
FLIGHT_SYNC_MODE=local
# Cloud remote mode only: public key file inside the container, never the private key.
FLIGHT_WORKER_PUBLIC_KEY_FILE=/data/flight-worker-public.pem
# Auto-publish newly logged completed flights. Existing records keep their visibility.
FLIGHT_SYNC_VISIBILITY=public
# Generate separately from PAYLOAD_SECRET: openssl rand -hex 32
FLIGHT_SYNC_TOKEN=
BARK_KEY=
BARK_SERVER_URL=https://api.day.app/
FR24_TRANSPORT=curl_cffi
# Python environment with scripts/flight-sync-requirements.txt installed.
FR24_PYTHON=python3
FR24_IMPERSONATE=chrome120

# Select the home-side data provider; no automatic paid fallback.
FLIGHT_DATA_PROVIDER=fr24
FLIGHTAWARE_API_KEY_FILE=

# Optional existing outbound proxy for FR24 only; leave empty for direct access.
FR24_PROXY=

# Public Pit Wall telemetry (server only).
# Deployment pipeline should set an ISO-8601 timestamp; missing values display as unknown.
DEPLOYED_AT=
# Status declaration only: this does not enable or configure a CDN.
# Set true at runtime after cos.merakt.cn caching and CORS have been verified.
# Local-media builds always display LOCAL, regardless of this flag.
CDN_EDGE_CACHE_ACTIVE=
# Optional monitoring-export JSON file: [{"at":"2026-10-16T06:00:00Z","ms":124}]
# Only valid samples in the latest 24 hours are displayed. No fabricated fallback data.
TELEMETRY_FILE=

# Local preview: enable for both build and runtime; production should leave unset.
LOCAL_PREVIEW=0
NEXT_PUBLIC_LOCAL_MEDIA=0
# Content-count query measurements; local server writes bounded 24-hour history.
CONTENT_TELEMETRY_FILE=./.data/telemetry/content-latency.json

# Manual VariFlight queries only; credentials stay on the home worker.
VARIFLIGHT_ENABLED=0
# Reservations include unknown outcomes; defaults cap estimates at CNY 2/day, CNY 10/month.
VARIFLIGHT_DAILY_QUERY_LIMIT=4
VARIFLIGHT_MONTHLY_QUERY_LIMIT=20

# Pit Lane friend links: probe approved friends every 15 min and fetch site logos (outbound UA: Mozilla/5.0 (compatible; MerakPitLane/1.0; +https://merakt.cn)). 0 disables.
PIT_LANE_MONITOR=0

# Optional public inbox shown as the "email" application channel on /pit-lane (hidden when empty).
PIT_LANE_EMAIL=

# No-reply mailbox for Pit Lane garage mails (approval, invite, password reset). Empty SMTP_HOST logs mails to the console.
# Port 465 uses TLS; 587 uses STARTTLS (override with SMTP_SECURE=1/0).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@merakt.cn
MAIL_FROM_NAME=Merak · 数字围场
