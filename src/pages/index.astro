---
import BaseLayout from '../layouts/BaseLayout.astro';
import { copy } from '../content/site-copy';
import { visibility } from '../content/site-settings';
import { status } from '../content/status';
const page = copy.home;
const routeHrefs = ['/merak', '/fursuitfriday', '/blog', '/airways', '/astronix'];
const routes = page.routes.map((route, index) => ({ route, href: routeHrefs[index], feature: index === 3 ? 'airways' : index === 4 ? 'astronix' : undefined })).filter(({ feature }) => !feature || visibility[feature]);
const latestPost = copy.blog.posts[0];
---
<BaseLayout title={page.title} description={page.description}>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="wrap home-hero-grid">
      <div class="home-intro">
        <p class="eyebrow">{page.eyebrow}</p>
        <h1 id="home-title">{page.heading.split("\n").map((line, index) => index === 0 ? <>{line}<br /></> : <span>{line}</span>)}</h1>
        <p class="lead">{page.lead}</p>
        <div class="actions"><a class="button" href="/merak">{page.primary}<span aria-hidden="true">↗</span></a><a class="text-link" href="/blog">{page.secondary}<span aria-hidden="true">→</span></a></div>
      </div>
      <a class="hero-photo" href="/fursuitfriday" aria-label="查看毛五照片">
        <img src="/images/fursuitfriday/2075533585021640945-HM3GyjNaoAAntON.jpg" width="2048" height="1366" alt="Merak 的蓝色毛五站在白色汽车旁" fetchpriority="high" />
        <span class="photo-link"><span>生活里的另一面</span><span>FursuitFriday <b aria-hidden="true">↗</b></span></span>
      </a>
    </div>
  </section>
  <section class="section about-section" aria-labelledby="about-heading">
    <div class="wrap about-layout">
      <div><p class="about-side">一个个人网站</p><h2 id="about-heading">{page.aboutHeading}<span class="accent">。</span></h2></div>
      <div class="about-copy"><p>{page.aboutLead}</p><p>{page.aboutCards[0][2]}</p></div>
    </div>
  </section>
  <section class="section directory-section" aria-labelledby="directory-title">
    <div class="wrap">
      <div class="section-head"><h2 id="directory-title">{page.routesHeading}</h2>{page.routesLead && <p>{page.routesLead}</p>}</div>
      <div class="directory">
        {routes.map(({ route: [label, heading, text], href }, index) => <a class="directory-entry" href={href}>
          <span class="directory-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <div><h3>{heading}</h3><p>{text}</p></div><span class="directory-label">{label.split(' / ')[1]}</span><span class="directory-arrow" aria-hidden="true">↗</span>
        </a>)}
      </div>
    </div>
  </section>
  <section class="section latest-section" aria-labelledby="latest-heading">
    <div class="wrap latest-layout">
      <div class="latest-heading"><h2 id="latest-heading">最近写下</h2><p>航行日志</p><a class="text-link" href="/blog">全部文章 <span aria-hidden="true">→</span></a></div>
      <a class="latest-post" href={latestPost.slug}><div class="post-meta"><time datetime={latestPost.date}>{latestPost.date.replaceAll('-', '.')}</time><span>{latestPost.category}</span></div><h3>{latestPost.title}<span aria-hidden="true">↗</span></h3><p>{latestPost.excerpt}</p><span class="post-read">阅读全文</span></a>
    </div>
  </section>
  <div class="wrap telemetry-link"><span>{status.home.text}</span><a class="text-link" href="/status">{status.home.heading}<span aria-hidden="true">↗</span></a></div>
</BaseLayout>
<style>
  .home-hero { padding:clamp(3rem,6vw,5.5rem) 0 4rem; }
  .home-hero-grid { display:grid; grid-template-columns:1fr 1fr; gap:clamp(2rem,5vw,5rem); align-items:center; }
  .home-intro h1 { font-size:clamp(2.6rem,5.3vw,4.7rem); margin-block:1.5rem; line-height:1.22; letter-spacing:-.07em; }
  .home-intro h1 span { color:var(--signal); }
  .home-intro .lead { max-width:29ch; }
  .home-intro .actions { gap:1.5rem; margin-top:2.25rem; }
  .hero-photo { display:block; min-width:0; }
  .hero-photo img { width:100%; aspect-ratio:1.08; height:auto; object-fit:cover; object-position:35% center; border-radius:16px; transition:filter .2s; }
  .hero-photo:hover img { filter:brightness(1.04); }
  .photo-link { display:flex; justify-content:space-between; gap:1rem; margin-top:1rem; font-size:.72rem; color:var(--muted); }
  .photo-link b { color:var(--signal); margin-left:.5rem; font-size:1rem; }
  .about-section { border-top:1px solid var(--line); padding-block:3.5rem; }
  .about-layout { display:grid; grid-template-columns:1fr 1.5fr; gap:5rem; }
  .about-side { color:var(--muted); font-size:.8rem; margin-bottom:.7rem; }
  .about-layout h2 { margin:0; }
  .accent { color:var(--signal); }
  .about-copy p:first-child { font-size:1.18rem; line-height:1.8; margin-bottom:1rem; }
  .about-copy p:last-child { color:var(--muted); font-size:.9rem; margin:0; }
  .directory-section { padding-top:4rem; }
  .directory { border-top:1px solid var(--line); }
  .directory-entry { display:grid; grid-template-columns:3.5rem 1fr auto 2.5rem; gap:1.5rem; align-items:center; padding:1.7rem 0; border-bottom:1px solid var(--line); transition:padding .2s,background .2s; }
  .directory-entry:hover { color:var(--ink); padding-inline:1rem; background:var(--surface); }
  .directory-number { align-self:start; padding-top:.25rem; color:var(--muted); font:.75rem/2 var(--font-data); }
  .directory-entry h3 { margin:0 0 .25rem; font-size:1.65rem; letter-spacing:-.04em; }
  .directory-entry p { margin:0; color:var(--muted); font-size:.88rem; }
  .directory-label { color:var(--muted); font:.64rem var(--font-data); letter-spacing:.08em; }
  .directory-arrow { font-size:1.6rem; color:var(--signal); text-align:right; }
  .latest-layout { display:grid; grid-template-columns:1fr 1.5fr; gap:5rem; }
  .latest-heading p { color:var(--muted); }
  .latest-heading .text-link { margin-top:1rem; }
  .latest-post { display:block; border-radius:10px; padding:2rem 2.5rem; background:var(--surface); border:1px solid var(--line); transition:border-color .2s; }
  .latest-post:hover { color:var(--ink); border-color:var(--signal); }
  .post-meta { display:flex; gap:1rem; font:.72rem var(--font-data); color:var(--muted); }
  .latest-post h3 { display:flex; justify-content:space-between; font-size:2.25rem; margin:1.25rem 0 .8rem; letter-spacing:-.05em; }
  .latest-post h3 span { color:var(--signal); font-size:1.5rem; }
  .latest-post p { color:var(--muted); font-size:.9rem; }
  .post-read { color:var(--signal); font-size:.83rem; }
  .telemetry-link { display:flex; justify-content:space-between; gap:2rem; padding:1.5rem 0; border-top:1px solid var(--line); color:var(--muted); font-size:.8rem; }
  @media (max-width:760px) {
    .home-hero { padding:3rem 0 2.5rem; }
    .home-hero-grid { grid-template-columns:1fr; gap:2.75rem; }
    .home-intro h1 { font-size:clamp(2.6rem,10vw,4.5rem); }
    .home-intro .lead { max-width:35ch; }
    .hero-photo img { aspect-ratio:1.3; }
    .about-layout,.latest-layout { grid-template-columns:1fr; gap:1.75rem; }
    .about-copy p:first-child { font-size:1.05rem; }
    .directory-entry { grid-template-columns:1.5rem 1fr 1.5rem; gap:1rem; padding-block:1.5rem; }
    .directory-entry h3 { font-size:1.4rem; }
    .directory-label { display:none; }
    .latest-post { padding:1.5rem; }
    .latest-heading .text-link { margin-top:0; }
    .telemetry-link { flex-direction:column; gap:.6rem; }
  }
</style>
