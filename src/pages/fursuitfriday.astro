---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { copy } from '../content/site-copy';
import { media } from '../content/site-settings';
const posts = (await getCollection('fursuitfriday')).filter(post => !/\.(?:mp4|webm|mov|m4v)(?:[?#]|$)/i.test(post.data.image)).sort((a,b) => new Date(b.data.time).getTime() - new Date(a.data.time).getTime());
const latest = posts[0];
const mediaUrl = (path: string) => !import.meta.env.DEV && path.startsWith('/images/fursuitfriday/') ? `${media.fursuitCdnOrigin}${path.replace('/images', '')}` : path;
---
<BaseLayout title={copy.fursuit.title} description={copy.fursuit.description}>
  <section class="page-hero fursuit-intro"><div class="wrap fursuit-intro-grid">
    <div><p class="eyebrow">{copy.fursuit.eyebrow}</p><h1>{copy.fursuit.heading}</h1><p class="lead">{copy.fursuit.lead}</p><p class="intro-note">{copy.fursuit.note}</p><a class="text-link" href="#archive-title">浏览照片档案 <span aria-hidden="true">↓</span></a></div>
    {latest && <figure class="latest-frame"><button class="photo-open" type="button" data-photo-index="0" aria-label="放大最新照片"><img src={mediaUrl(latest.data.image)} data-fallback={latest.data.image} alt={latest.data.caption} fetchpriority="high" decoding="async" /></button><figcaption><span>{copy.fursuit.latest}</span><time datetime={latest.data.time.replace(' ', 'T')}>{latest.data.time.slice(0,10).replaceAll('-', '.')}</time></figcaption></figure>}
  </div></section>
  <section class="section fursuit-archive" aria-labelledby="archive-title"><div class="wrap">
    <div class="archive-head"><h2 id="archive-title">{copy.fursuit.archiveHeading}</h2><p>{copy.fursuit.archiveSummary(posts.length)}</p></div>
    <div class="contact-sheet">{posts.map((post,index) => <figure class="photo-entry"><button class="photo-open" type="button" data-photo-index={index} aria-label={`放大照片：${post.data.caption}`}><img src={mediaUrl(post.data.image)} data-fallback={post.data.image} alt={post.data.caption} loading="lazy" decoding="async" /></button><figcaption><time datetime={post.data.time.replace(' ', 'T')}>{post.data.time.slice(0,10).replaceAll('-', '.')}</time><p>{post.data.caption}</p></figcaption></figure>)}</div>
    {posts.length === 0 && <p class="notice">照片还在整理中，稍后再来看看。</p>}
  </div></section>
  <dialog class="photo-dialog" aria-label="照片查看器" id="photoDialog">
    <div class="viewer-bar"><span id="photoCounter" aria-live="polite"></span><button class="viewer-close" type="button" aria-label="关闭照片">关闭 <span aria-hidden="true">×</span></button></div>
    <div class="viewer-stage"><img id="viewerImage" alt="" /></div>
    <div class="viewer-bottom"><p id="viewerCaption"></p><div class="viewer-controls"><button type="button" id="previousPhoto" aria-label="上一张照片">←</button><button type="button" id="nextPhoto" aria-label="下一张照片">→</button></div></div>
  </dialog>
</BaseLayout>
<script>
  let cleanup = () => {};
  function initializeGallery() {
    cleanup();
    const dialog = document.querySelector<HTMLDialogElement>('#photoDialog');
    if (!dialog) return;
    const controller = new AbortController();
    const { signal } = controller;
    const entries = Array.from(document.querySelectorAll<HTMLElement>('.photo-entry'));
    const image = dialog.querySelector<HTMLImageElement>('#viewerImage')!;
    let index = 0;
    let previousOverflow = '';
    const show = (next: number) => {
      index = (next + entries.length) % entries.length;
      const source = entries[index].querySelector('img')!;
      image.src = source.currentSrc || source.src;
      image.alt = source.alt;
      image.dataset.fallback = source.dataset.fallback;
      dialog.querySelector('#viewerCaption')!.textContent = source.alt;
      dialog.querySelector('#photoCounter')!.textContent = `${index + 1} / ${entries.length}`;
    };
    document.addEventListener('error', event => {
      const target = event.target;
      if (target instanceof HTMLImageElement && target.dataset.fallback) {
        const fallback = target.dataset.fallback;
        delete target.dataset.fallback;
        target.src = fallback;
      }
    }, { capture: true, signal });
    document.querySelectorAll<HTMLImageElement>('img[data-fallback]').forEach(img => {
      if (img.complete && img.naturalWidth === 0) { const fallback = img.dataset.fallback!; delete img.dataset.fallback; img.src = fallback; }
    });
    document.querySelectorAll<HTMLButtonElement>('[data-photo-index]').forEach(button => button.addEventListener('click', () => {
      show(Number(button.dataset.photoIndex));
      previousOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      dialog.showModal();
    }, { signal }));
    dialog.querySelector('.viewer-close')?.addEventListener('click', () => dialog.close(), { signal });
    dialog.addEventListener('close', () => { document.body.style.overflow = previousOverflow; }, { signal });
    dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); }, { signal });
    dialog.querySelector('#previousPhoto')?.addEventListener('click', () => show(index-1), { signal });
    dialog.querySelector('#nextPhoto')?.addEventListener('click', () => show(index+1), { signal });
    dialog.addEventListener('keydown', event => {
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') { event.preventDefault(); show(index + (event.key === 'ArrowRight' ? 1 : -1)); }
    }, { signal });
    cleanup = () => { if (dialog.open) dialog.close(); controller.abort(); document.body.style.overflow = previousOverflow; };
  }
  document.addEventListener('astro:page-load', initializeGallery);
  document.addEventListener('astro:before-swap', () => cleanup());
</script>
<style>
  .fursuit-intro-grid { display:grid; grid-template-columns:.8fr 1.2fr; align-items:center; gap:5rem; }
  .fursuit-intro h1 { font-size:clamp(4rem,8vw,7rem); }
  .intro-note { margin:1.75rem 0; font-size:.8rem; color:var(--muted); }
  .latest-frame { margin:0; }
  .photo-open { display:block; width:100%; padding:0; border:0; border-radius:12px; background:var(--surface); overflow:hidden; cursor:zoom-in; }
  .photo-open img { width:100%; height:auto; transition:transform .35s; }
  .photo-open:hover img { transform:scale(1.025); }
  .latest-frame figcaption { display:flex; justify-content:space-between; padding-top:1rem; color:var(--muted); font-size:.72rem; }
  .archive-head { margin-bottom:2.5rem; }
  .archive-head h2 { margin-bottom:.6rem; }
  .archive-head p { margin:0; color:var(--muted); font-size:.85rem; }
  .contact-sheet { columns:3; column-gap:1.75rem; }
  .photo-entry { display:inline-block; width:100%; margin:0 0 2.5rem; break-inside:avoid; }
  .photo-entry figcaption { padding-top:1rem; }
  .photo-entry time { color:var(--muted); font:.68rem var(--font-data); }
  .photo-entry p { margin:.4rem 0 0; white-space:pre-line; font-size:.85rem; line-height:1.7; }
  .photo-dialog { width:min(1100px,calc(100% - 3rem)); max-height:calc(100dvh - 3rem); padding:1.25rem; background:var(--canvas); color:var(--ink); border:1px solid var(--line); border-radius:16px; }
  .photo-dialog::backdrop { background:rgb(8 12 10 / .85); }
  .viewer-bar,.viewer-bottom { display:flex; justify-content:space-between; align-items:center; gap:1.5rem; }
  .viewer-bar { padding-bottom:1rem; }
  #photoCounter { font:.75rem var(--font-data); color:var(--muted); }
  .viewer-close { border:0; background:transparent; font-size:.85rem; min-height:40px; }
  .viewer-close span { margin-left:.6rem; font-size:1.3rem; }
  .viewer-stage { display:grid; place-items:center; min-height:12rem; }
  .viewer-stage img { max-height:65dvh; object-fit:contain; border-radius:6px; }
  .viewer-bottom { padding-top:1rem; }
  #viewerCaption { margin:0; font-size:.8rem; white-space:pre-line; }
  .viewer-controls { display:flex; gap:.5rem; }
  .viewer-controls button { width:44px; height:44px; background:var(--surface); border:1px solid var(--line); border-radius:50%; }
  .viewer-controls button:hover { border-color:var(--signal); color:var(--signal); }
  @media (max-width:1024px) { .contact-sheet { columns:2; } .fursuit-intro-grid { gap:2rem; } }
  @media (max-width:760px) { .fursuit-intro-grid { grid-template-columns:1fr; } .fursuit-intro h1 { margin-block:1rem; } .contact-sheet { column-gap:1rem; } .photo-entry { margin-bottom:2rem; } .photo-dialog { width:calc(100% - 1rem); padding:1rem; } }
  @media (max-width:480px) { .contact-sheet { columns:1; } }
</style>
