---
import { copy } from '../content/site-copy';
import { visibility } from '../content/site-settings';
import { status } from '../content/status';
import { ClientRouter } from 'astro:transitions';
import { execFileSync } from 'node:child_process';
import '../styles/global.css';
const repositoryUrl = 'https://github.com/MerakW/merakt.cn';
const commit = (() => {
  const ciCommit = process.env.GITHUB_SHA;
  if (ciCommit && /^[a-f0-9]{40}$/i.test(ciCommit)) return ciCommit;
  try {
    return execFileSync('git', ['rev-parse', '--verify', 'HEAD'], {
      encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'],
    }).trim();
  } catch {
    return null;
  }
})();
interface Props { title: string; description?: string; }
const { title, description = copy.site.defaultDescription } = Astro.props;
const path = Astro.url.pathname;
const links = [...copy.site.nav.slice(0, 4), ['/status', status.navLabel], ...copy.site.nav.slice(4)].filter(([href]) =>
  (href !== '/astronix' || visibility.astronix) && (href !== '/airways' || visibility.airways),
);
const isActive = (href: string) => href === '/' ? path === href : path === href || path.startsWith(`${href}/`);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      (() => {
        let theme;
        try { theme = sessionStorage.getItem('merak-theme-override'); } catch {}
        document.documentElement.dataset.theme = theme === 'light' || theme === 'dark' ? theme : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      })();
    </script>
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">跳至主要内容</a>
    <div class="site-shell">
      <header class="site-header">
        <nav class="nav wrap" aria-label="主要导航">
          <a class="brand" href="/" aria-label="Merak 首页"><img src="/logo.webp" width="128" height="128" alt="" /><span>MERAK</span></a>
          <ul class="nav-links" id="siteMenu">
            {links.map(([href, label]) => <li><a href={href} aria-current={isActive(href) ? 'page' : undefined}>{label}</a></li>)}
          </ul>
          <div class="nav-tools">
            <button class="theme-button" id="themeButton" type="button" aria-label="切换深浅主题" aria-pressed="false"><span aria-hidden="true">◐</span></button>
            <button class="menu-button" id="menuButton" type="button" aria-label="打开导航" aria-controls="siteMenu" aria-expanded="false"><span></span><span></span></button>
          </div>
        </nav>
      </header>
      <div class="menu-scrim" id="menuScrim" aria-hidden="true"></div>
      <main id="main" tabindex="-1"><slot /></main>
      <footer class="site-footer">
        <div class="wrap footer-top">
          <div><a href="/" class="footer-wordmark">MERAK<span aria-hidden="true">.</span></a><p>{copy.site.footer.motto}</p></div>
          <nav aria-label="页脚导航">{links.map(([href, label]) => <a href={href}>{label}</a>)}</nav>
        </div>
        <div class="wrap footer-bottom">
          <span>{copy.site.footer.copyright}</span>
          <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">{copy.site.footer.filing}</a>
          <div class="build-record" aria-label="代码与构建信息">
            <a href={repositoryUrl} target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.1a6.9 6.9 0 0 0-2.18 13.44c.35.06.48-.15.48-.34v-1.2c-1.96.43-2.38-.83-2.38-.83-.32-.82-.79-1.04-.79-1.04-.64-.44.05-.43.05-.43.71.05 1.08.73 1.08.73.63 1.08 1.65.77 2.05.59.06-.46.25-.77.45-.95-1.56-.18-3.2-.78-3.2-3.47 0-.77.28-1.4.73-1.9-.07-.18-.32-.9.07-1.88 0 0 .6-.19 1.96.72A6.8 6.8 0 0 1 8 4.3c.6 0 1.2.08 1.76.24 1.36-.91 1.96-.72 1.96-.72.39.98.14 1.7.07 1.88.45.5.73 1.13.73 1.9 0 2.7-1.65 3.29-3.22 3.46.25.22.48.65.48 1.31v1.94c0 .19.13.4.48.34A6.9 6.9 0 0 0 8 1.1Z" /></svg>REPOSITORY / MERAKW·MERAKT.CN</a>
            {commit ? <a href={`${repositoryUrl}/commit/${commit}`} target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2 8h3.25m5.5 0H14M8 10.25a2.25 2.25 0 1 0 0-4.5 2.25 2.25 0 0 0 0 4.5Z" /></svg>BUILD / {commit.slice(0, 7)}</a> : <span class="build-local">BUILD / LOCAL</span>}
          </div>
        </div>
      </footer>
    </div>
    <script>
      let cleanup = () => {};
      function initializeShell() {
        cleanup();
        const controller = new AbortController();
        const { signal } = controller;
        const root = document.documentElement;
        const menu = document.querySelector<HTMLElement>('#siteMenu');
        const button = document.querySelector<HTMLButtonElement>('#menuButton');
        const scrim = document.querySelector('#menuScrim');
        const theme = document.querySelector('#themeButton');
        const system = matchMedia('(prefers-color-scheme: dark)');
        const mobile = matchMedia('(max-width: 760px)');
        const syncTheme = () => {
          let override;
          try { override = sessionStorage.getItem('merak-theme-override'); } catch {}
          const next = override === 'dark' || override === 'light' ? override : system.matches ? 'dark' : 'light';
          root.dataset.theme = next;
          theme?.setAttribute('aria-pressed', String(next === 'dark'));
          window.dispatchEvent(new CustomEvent('merak:theme-change', { detail: next }));
        };
        const closeMenu = (restoreFocus = false) => {
          button?.setAttribute('aria-expanded', 'false');
          button?.setAttribute('aria-label', '打开导航');
          menu?.classList.remove('is-open');
          scrim?.classList.remove('is-open');
          document.body.classList.remove('menu-open');
          if (menu) menu.inert = mobile.matches;
          document.querySelector<HTMLElement>('#main')?.removeAttribute('inert');
          document.querySelector<HTMLElement>('.site-footer')?.removeAttribute('inert');
          if (restoreFocus) button?.focus();
        };
        button?.addEventListener('click', () => {
          if (button.getAttribute('aria-expanded') === 'true') return closeMenu(true);
          if (menu) menu.inert = false;
          button.setAttribute('aria-expanded', 'true');
          button.setAttribute('aria-label', '关闭导航');
          menu?.classList.add('is-open');
          scrim?.classList.add('is-open');
          document.body.classList.add('menu-open');
          document.querySelector<HTMLElement>('#main')?.setAttribute('inert', '');
          document.querySelector<HTMLElement>('.site-footer')?.setAttribute('inert', '');
          menu?.querySelector('a')?.focus();
        }, { signal });
        scrim?.addEventListener('click', () => closeMenu(true), { signal });
        menu?.addEventListener('click', (event) => { if ((event.target as Element).closest('a')) closeMenu(); }, { signal });
        document.addEventListener('keydown', (event) => {
          if (button?.getAttribute('aria-expanded') !== 'true') return;
          if (event.key === 'Escape') { event.preventDefault(); closeMenu(true); }
          if (event.key === 'Tab') {
            const items = Array.from(document.querySelectorAll<HTMLElement>('.nav a, .nav button')).filter(el => el.getClientRects().length);
            const first = items[0], last = items[items.length - 1];
            if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
            else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
          }
        }, { signal });
        theme?.addEventListener('click', () => {
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          try { sessionStorage.setItem('merak-theme-override', next); } catch {}
          root.dataset.theme = next;
          theme.setAttribute('aria-pressed', String(next === 'dark'));
          window.dispatchEvent(new CustomEvent('merak:theme-change', { detail: next }));
        }, { signal });
        system.addEventListener('change', syncTheme, { signal });
        mobile.addEventListener('change', () => closeMenu(), { signal });
        closeMenu();
        syncTheme();
        cleanup = () => controller.abort();
      }
      document.addEventListener('astro:page-load', initializeShell);
      document.addEventListener('astro:before-swap', () => cleanup());
    </script>
  </body>
</html>
